.history-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

.search-bar {
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #BBBBBB;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
}

.list-total {
  font-size: 24rpx;
  color: #999999;
}

.list-clear {
  font-size: 24rpx;
  color: #E74C3C;
}

.section-label {
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 24rpx 8rpx;
}

.conversation-item {
  display: flex;
  margin: 8rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.conv-pinned {
  border-left: 6rpx solid #4A90D9;
}

.conv-content {
  flex: 1;
  padding: 24rpx;
  min-width: 0;
}

.conv-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.conv-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.conv-time {
  font-size: 22rpx;
  color: #BBBBBB;
  flex-shrink: 0;
}

.conv-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-preview {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.conv-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.conv-count {
  font-size: 22rpx;
  color: #BBBBBB;
}

.pin-badge {
  font-size: 20rpx;
  color: #4A90D9;
  background-color: #E8F0FE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.conv-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-text {
  font-size: 22rpx;
  white-space: nowrap;
}

.action-pin .action-text {
  color: #4A90D9;
}

.action-unpin .action-text {
  color: #F39C12;
}

.action-rename .action-text {
  color: #3498DB;
}

.action-delete .action-text {
  color: #E74C3C;
}

.action-export .action-text {
  color: #4A90D9;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #4A90D9;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #BBBBBB;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 64rpx;
  background-color: #4A90D9;
  border-radius: 36rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.rename-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.rename-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.rename-show {
  transform: translateY(0);
}

.rename-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.rename-cancel {
  font-size: 30rpx;
  color: #999999;
}

.rename-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.rename-confirm {
  font-size: 30rpx;
  color: #4A90D9;
}

.rename-body {
  padding: 32rpx;
}

.rename-input {
  width: 100%;
  height: 80rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
