.stats-page {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A90D9;
}

.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.overview-card {
  flex: 1;
  min-width: 140rpx;
  background: linear-gradient(135deg, #4A90D9, #6BB5F0);
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.overview-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.bar-chart {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bar-label {
  font-size: 24rpx;
  color: #666;
  width: 120rpx;
  text-align: right;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 28rpx;
  background: #F0F0F0;
  border-radius: 14rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #6BB5F0);
  border-radius: 14rpx;
  min-width: 8rpx;
  transition: width 0.3s;
}

.bar-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
  width: 60rpx;
  flex-shrink: 0;
}

.type-grid {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  min-width: 120rpx;
}

.type-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 24rpx;
  color: #666;
}

.type-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A90D9;
  margin-top: 4rpx;
}

.daily-chart {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 300rpx;
  padding: 0 4rpx;
}

.daily-item {
  flex: 1;
  min-width: 40rpx;
  max-width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.daily-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.daily-bar {
  width: 80%;
  background: linear-gradient(180deg, #4A90D9, #6BB5F0);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 8rpx;
}

.daily-date {
  font-size: 16rpx;
  color: #999;
  margin-top: 6rpx;
  flex-shrink: 0;
  transform: scale(0.85);
  transform-origin: center top;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
