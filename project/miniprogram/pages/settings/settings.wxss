.settings-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

.user-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #EEEEEE;
}

.avatar-edit-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFFFFF;
}

.edit-badge-icon {
  font-size: 18rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.user-id {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

.section-title {
  font-size: 24rpx;
  color: #999999;
  padding: 24rpx 24rpx 8rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #333333;
}

.setting-right {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.logout-section {
  margin-top: 60rpx;
  padding: 0 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  color: #E74C3C;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  letter-spacing: 4rpx;
  padding: 0;
}

.btn-logout::after {
  border: none;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-show {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.picker-cancel {
  font-size: 30rpx;
  color: #999999;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.picker-confirm {
  font-size: 30rpx;
  color: #4A90D9;
}

.picker-options {
  padding: 16rpx 32rpx;
}

.picker-option {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.picker-option-active {
  background-color: #F0F5FF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
}

.picker-option-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.picker-option-info {
  flex: 1;
}

.picker-option-name {
  font-size: 30rpx;
  color: #333333;
  display: block;
}

.picker-option-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
  display: block;
}

.picker-check {
  font-size: 32rpx;
  color: #4A90D9;
}

.profile-edit-content {
  padding: 32rpx;
}

.profile-avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.profile-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.profile-avatar-right {
  display: flex;
  align-items: center;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #EEEEEE;
  margin-right: 12rpx;
}

.profile-nickname-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.profile-nickname-input {
  text-align: right;
  font-size: 28rpx;
  color: #666666;
  flex: 1;
  margin-left: 32rpx;
}
