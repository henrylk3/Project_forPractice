.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(160deg, #0f0c29 0%, #302b63 40%, #24243e 100%);
  position: relative;
  overflow: hidden;
}

.login-container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.4) 0%, transparent 70%);
  animation: pulse1 4s ease-in-out infinite;
}

.login-container::after {
  content: '';
  position: absolute;
  bottom: -150rpx;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  animation: pulse2 5s ease-in-out infinite 1s;
}

.login-bg-circle1 {
  position: absolute;
  top: 20%;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(118, 75, 162, 0.3) 0%, transparent 70%);
  animation: floatUp 6s ease-in-out infinite;
}

.login-bg-circle2 {
  position: absolute;
  top: 10%;
  right: 30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.25) 0%, transparent 70%);
  animation: floatUp 8s ease-in-out infinite 2s;
}

.login-bg-circle3 {
  position: absolute;
  bottom: 20%;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.2) 0%, transparent 70%);
  animation: floatUp 7s ease-in-out infinite 1s;
}

@keyframes floatUp {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-30rpx); }
}

@keyframes pulse1 {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.1); opacity: 1; }
}

@keyframes pulse2 {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.15); opacity: 0.9; }
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
  position: relative;
  z-index: 1;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 32rpx;
  background-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4), 0 0 60rpx rgba(102, 126, 234, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(102, 126, 234, 0.5);
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

.login-actions {
  width: 100%;
  position: relative;
  z-index: 1;
}

.btn-wx-login {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 243, 255, 0.95) 100%);
  border-radius: 48rpx;
  border: none;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-wx-login::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
  color: #302b63;
  font-weight: 600;
}

.btn-disabled {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(240, 243, 255, 0.5) 100%) !important;
  opacity: 0.6;
}

.wx-hint {
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.hint-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.profile-setup {
  width: 100%;
  position: relative;
  z-index: 1;
}

.profile-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 247, 255, 0.98) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2), 0 0 80rpx rgba(102, 126, 234, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.profile-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #302b63;
  margin-bottom: 12rpx;
}

.profile-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.profile-avatar-section {
  margin-bottom: 36rpx;
}

.avatar-choose-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.avatar-choose-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  border: 4rpx dashed #CCCCCC;
}

.avatar-edit-hint {
  margin-top: 12rpx;
}

.edit-hint-text {
  font-size: 24rpx;
  color: #667eea;
}

.profile-nickname-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.profile-nickname-input {
  width: 100%;
  height: 80rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

.btn-start-chat {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.5);
}

.btn-start-chat::after {
  border: none;
}

.btn-start-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.login-footer {
  position: fixed;
  bottom: 80rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  z-index: 1;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.footer-link {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
