.chat-input-wrap {
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  padding: 12rpx 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 36rpx;
  padding: 4rpx 8rpx 4rpx 4rpx;
}

.toolbar-group {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.toolbar-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.toolbar-btn-recording {
  background-color: #E74C3C;
}

.toolbar-icon {
  font-size: 32rpx;
}

.message-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
}

.send-btn {
  flex-shrink: 0;
  width: 108rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #CCCCCC;
  border-radius: 32rpx;
  margin-left: 8rpx;
  transition: background-color 0.2s;
}

.send-btn-active {
  background-color: #4A90D9;
}

.send-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #999999;
}

.send-btn-active .send-text {
  color: #FFFFFF;
}

.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.suggestion-item {
  padding: 8rpx 20rpx;
  background-color: #F0F5FF;
  border-radius: 20rpx;
  border: 1rpx solid #D0DEFF;
}

.suggestion-text {
  font-size: 24rpx;
  color: #4A90D9;
}

.emoji-panel {
  margin-top: 12rpx;
  height: 360rpx;
}

.emoji-scroll {
  height: 360rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx;
}

.emoji-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji-char {
  font-size: 48rpx;
}

.recording-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.recording-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.7);
  padding: 48rpx 64rpx;
  border-radius: 24rpx;
}

.recording-waves {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.rec-wave {
  width: 12rpx;
  height: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  transition: height 0.15s ease, background-color 0.15s ease;
}

.rec-wave-active {
  background-color: #4A90D9;
  height: 60rpx;
}

.recording-text {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.recording-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24rpx;
}

.recording-actions {
  display: flex;
  gap: 32rpx;
}

.recording-btn {
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
}

.recording-cancel {
  background-color: rgba(255, 255, 255, 0.15);
}

.recording-stop {
  background-color: #4A90D9;
}

.recording-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
