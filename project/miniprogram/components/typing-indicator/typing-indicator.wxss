.typing-indicator {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #EEEEEE;
}

.typing-dots {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #CCCCCC;
  margin: 0 6rpx;
  animation: typingBounce 1.4s infinite ease-in-out;
}

.dot1 {
  animation-delay: 0s;
}

.dot2 {
  animation-delay: 0.2s;
}

.dot3 {
  animation-delay: 0.4s;
}

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
